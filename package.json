{
  "name": "moa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@moa/client",
    "dev:admin": "turbo run dev --filter=@moa/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5"
  }
}
